    // ---- ARCHIVISION : synchro des maquettes / photos (avModels, avPhotos) et « Voir en AR sur le PC » (arLive) ----
    match /avModels/{mid} {
      function avOk(d) {
        return d.keys().hasOnly(['ownerUid', 'name', 'kind', 'size', 'unitScale', 'thumb', 'stats', 'createdAt', 'updatedAt', 'glbSize', 'hasSource'])
          && d.ownerUid == request.auth.uid
          && d.name is string && d.name.size() > 0 && d.name.size() <= 200
          && d.updatedAt is number && d.createdAt is number
          && d.get('thumb', '').size() <= 300000;
      }
      allow get, list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && isActiveUser() && avOk(request.resource.data);
      allow update: if isSignedIn() && isActiveUser() && resource.data.ownerUid == request.auth.uid && avOk(request.resource.data);
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /avPhotos/{pid} {
      function avpOk(d) {
        return d.keys().hasOnly(['ownerUid', 'modelId', 'modelName', 'size', 'w', 'h', 'thumb', 'note', 'mode', 'createdAt', 'updatedAt'])
          && d.ownerUid == request.auth.uid
          && d.modelId is string && d.modelId.size() <= 80
          && d.updatedAt is number && d.createdAt is number
          && d.get('note', '').size() <= 5000 && d.get('thumb', '').size() <= 300000;
      }
      allow get, list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && isActiveUser() && avpOk(request.resource.data);
      allow update: if isSignedIn() && isActiveUser() && resource.data.ownerUid == request.auth.uid && avpOk(request.resource.data);
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /arLive/{code} {
      allow get: if request.auth != null && resource.data.expiresAt > request.time;      // pas de « list » : impossible de lister les codes
      allow create: if request.auth != null
        && code.matches('[A-HJ-NP-Z2-9]{6}')
        && request.resource.data.keys().hasOnly(['v', 'code', 'owner', 'expires', 'expiresAt', 'createdAt', 'state', 'model', 'objects'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(3, 'h')
        && request.resource.data.state == 'open'
        && request.resource.data.objects is list && request.resource.data.objects.size() <= 300;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']);   // l'hôte peut seulement clore la session
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    
      match /moves/{i} {
        function sess() { return get(/databases/$(database)/documents/arLive/$(code)).data; }
        allow read: if request.auth != null && sess().expiresAt > request.time;
        allow create, update: if request.auth != null && sess().expiresAt > request.time && sess().state == 'open'
          && request.resource.data.keys().hasOnly(['i', 'p', 'seq', 'c', 't'])             // position uniquement : ni rotation, ni échelle, ni suppression
          && request.resource.data.i is int && string(request.resource.data.i) == i && request.resource.data.i < 300
          && request.resource.data.p is list && request.resource.data.p.size() == 3
          && request.resource.data.p[0] is number && request.resource.data.p[1] is number && request.resource.data.p[2] is number
          && request.resource.data.seq is number && request.resource.data.c is string && request.resource.data.c.size() <= 16;
      }
    }
