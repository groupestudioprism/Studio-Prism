    // ------------------------------------------------------------ ARCHIPLAN : fiche client clientProfiles/{uid}
    //
    function validClientProfile() {
      let d = request.resource.data;
      return d.keys().hasAll(['phone', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['phone', 'profile', 'company', 'address', 'postalCode', 'city', 'country', 'siret', 'createdAt', 'updatedAt'])
        && (d.get('siret', '') == '' || (d.siret is string && d.siret.matches('[0-9]{14}')))
        && isString(d.phone, 6, 40)
        && isString(d.get('profile', ''), 0, 120)
        && isString(d.get('company', ''), 0, 120)
        && isString(d.get('address', ''), 0, 200)
        && isString(d.get('postalCode', ''), 0, 20)
        && isString(d.get('city', ''), 0, 120)
        && isString(d.get('country', ''), 0, 120)
        && d.updatedAt == request.time;
    }

    // ---------------------------------------------------------------- clientProfiles
    match /clientProfiles/{uid} {
      allow get: if isSignedIn() && ((request.auth.uid == uid && isActiveUser()) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid && isActiveUser() && validClientProfile()
                    && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == uid && isActiveUser() && validClientProfile()
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    //
    function apQuota(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      let lp = /databases/$(database)/documents/licenses/$(uid + '_archiplan');
      return isActiveAdminProfile(u) ? 1000000000
        : (exists(lp) && get(lp).data.status == 'active'
           && (get(lp).data.get('expiresAt', null) == null || get(lp).data.expiresAt > request.time)) ? 50000000
        : 10000000;
    }

    function apValidProject(d) {
      return d.keys().hasAll(['ownerUid', 'name', 'folderId', 'linkMode', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['ownerUid', 'ownerEmail', 'ownerName', 'name', 'folderId', 'size', 'thumb', 'linkMode', 'linkKey', 'linkToken',
                             'linkPw', 'createdAt', 'updatedAt', 'updatedBy', 'updatedByName'])
        && isString(d.name, 1, 120)
        && isString(d.folderId, 0, 40)
        && isString(d.get('ownerEmail', ''), 0, 160)
        && isString(d.get('ownerName', ''), 0, 160)
        && isString(d.get('updatedByName', ''), 0, 160)
        && isString(d.get('updatedBy', ''), 0, 128)
        && d.get('size', 0) is int && d.get('size', 0) >= 0 && d.get('size', 0) <= 1000000
        && isString(d.get('thumb', ''), 0, 90000)
        && (d.get('thumb', '') == '' || d.thumb.matches('data:image/(jpeg|png|webp);base64,.*'))
        && d.linkMode in ['off', 'view', 'edit']
        && isString(d.get('linkKey', ''), 0, 128)
        && isString(d.get('linkToken', ''), 0, 64)
        && d.get('linkPw', false) is bool
        && d.updatedAt == request.time
        && (d.folderId == '' || !existsAfter(gF('ap', d.folderId)) || getAfter(gF('ap', d.folderId)).data.ownerUid == d.ownerUid);
    }

    // ---------------------------------------------------------------- apProjects
    match /apProjects/{pid} {
      allow get: if gCanRead('ap', pid, resource.data);
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isActiveUser()
                    && apValidProject(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    && (request.resource.data.ownerUid == request.auth.uid
                        || (request.resource.data.folderId != '' && gFolderRole('ap', request.resource.data.folderId) == 'edit'
                            && getAfter(gF('ap', request.resource.data.folderId)).data.pids.hasAny([pid])))
                    && gUsageOk('ap', request.resource.data.ownerUid, pid, request.resource.data.get('size', 0));
      allow update: if isSignedIn() && apValidProject(request.resource.data)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && ((resource.data.ownerUid == request.auth.uid && isActiveUser())
                        || (gCanEdit('ap', pid, resource.data)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['size', 'thumb', 'updatedAt', 'updatedBy', 'updatedByName'])))
                    && gUsageOk('ap', resource.data.ownerUid, pid, request.resource.data.get('size', 0) - resource.data.get('size', 0));
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /content/{cid} {
        allow get: if cid == 'main' && gCanRead('ap', pid, get(gP('apProjects', pid)).data);
        allow create, update: if cid == 'main'
                              && gCanEdit('ap', pid, getAfter(gP('apProjects', pid)).data)
                              && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
                              && request.resource.data.data is string
                              && request.resource.data.data.size() <= 1000000
                              && request.resource.data.data.size() <= getAfter(gP('apProjects', pid)).data.get('size', 0) + 2048
                              && request.resource.data.updatedAt == request.time;
        allow delete: if isSignedIn() && (!exists(gP('apProjects', pid)) || get(gP('apProjects', pid)).data.ownerUid == request.auth.uid || isAdmin());
      }
    }

    // ---------------------------------------------------------------- apUsage
    match /apUsage/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && isActiveUser()
                            && request.resource.data.keys().hasOnly(['bytes', 'lastPid', 'updatedAt'])
                            && request.resource.data.bytes is int && request.resource.data.bytes >= 0
                            && isString(request.resource.data.lastPid, 0, 40)
                            && request.resource.data.updatedAt == request.time
                            && ((resource == null && request.resource.data.lastPid == '')
                                || request.resource.data.bytes <= (resource == null ? 0 : resource.data.bytes)
                                || request.resource.data.bytes <= apQuota(uid))
                            && (
                              (resource == null && request.auth.uid == uid && request.resource.data.lastPid == '')
                              || (request.resource.data.lastPid != ''
                                  && (existsAfter(gP('apProjects', request.resource.data.lastPid))
                                      ? (getAfter(gP('apProjects', request.resource.data.lastPid)).data.ownerUid == uid
                                         && request.resource.data.bytes - (resource == null ? 0 : resource.data.bytes)
                                            == getAfter(gP('apProjects', request.resource.data.lastPid)).data.get('size', 0)
                                               - (exists(gP('apProjects', request.resource.data.lastPid)) ? get(gP('apProjects', request.resource.data.lastPid)).data.get('size', 0) : 0))
                                      : (exists(gP('apProjects', request.resource.data.lastPid))
                                         && get(gP('apProjects', request.resource.data.lastPid)).data.ownerUid == uid
                                         && request.auth.uid == uid
                                         && request.resource.data.bytes - (resource == null ? 0 : resource.data.bytes)
                                            == -get(gP('apProjects', request.resource.data.lastPid)).data.get('size', 0))))
                            );
      allow delete: if (isSignedIn() && request.auth.uid == uid
                    && (resource.data.bytes == 0 || !existsAfter(/databases/$(database)/documents/users/$(uid))))
                    || isAdmin();
    }

    // ---------------------------------------------------------------- apFolders
    match /apFolders/{fid} {
      allow get: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || (isActiveUser() && gFolderRole('ap', fid) in ['view', 'edit']));
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isActiveUser() && gValidFolder(request.resource.data)
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && isActiveUser() && gValidFolder(request.resource.data)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (resource.data.ownerUid == request.auth.uid
                        || (gFolderRole('ap', fid) == 'edit'
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pids', 'updatedAt'])
                            && request.resource.data.get('pids', []).hasAll(resource.data.get('pids', []))));
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    function apValidShare(sid) {
      let d = request.resource.data;
      let folder = d.get('kind', 'project') == 'folder';
      return d.keys().hasAll(['email', 'role', 'ownerUid', 'createdAt'])
        && d.keys().hasOnly(['kind', 'pid', 'fid', 'email', 'role', 'ownerUid', 'name', 'ownerName', 'createdAt'])
        && d.get('kind', 'project') in ['project', 'folder']
        && isEmail(d.email) && d.email == d.email.lower()
        && d.role in ['view', 'edit']
        && d.ownerUid == request.auth.uid
        && isString(d.get('name', ''), 0, 120)
        && isString(d.get('ownerName', ''), 0, 160)
        && (folder
            ? (!('pid' in d) && isString(d.get('fid', ''), 1, 60) && sid == 'F_' + d.fid + '__' + d.email
               && get(gF('ap', d.fid)).data.ownerUid == request.auth.uid)
            : (!('fid' in d) && isString(d.get('pid', ''), 1, 60) && sid == d.pid + '__' + d.email
               && get(gP('apProjects', d.pid)).data.ownerUid == request.auth.uid));
    }

    // ---------------------------------------------------------------- apShares
    match /apShares/{sid} {
      allow get, list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.email == gEmail() || isAdmin());
      allow create: if isSignedIn() && isActiveUser() && apValidShare(sid) && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && isActiveUser() && resource.data.ownerUid == request.auth.uid && apValidShare(sid);
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.email == gEmail() || isAdmin());
    }

    function apValidGrant(gid) {
      let d = request.resource.data;
      let folder = d.get('kind', 'project') == 'folder';
      let t = folder ? get(gF('ap', d.get('fid', '-'))).data : get(gP('apProjects', d.get('pid', '-'))).data;
      return d.keys().hasOnly(['kind', 'pid', 'fid', 'uid', 'key', 'createdAt'])
        && d.get('kind', 'project') in ['project', 'folder']
        && d.uid == request.auth.uid
        && (folder ? (!('pid' in d) && isString(d.get('fid', ''), 1, 60) && gid == 'F_' + d.fid + '__' + request.auth.uid)
                   : (!('fid' in d) && isString(d.get('pid', ''), 1, 60) && gid == d.pid + '__' + request.auth.uid))
        && isString(d.key, 1, 128)
        && d.createdAt == request.time
        && t.get('linkMode', 'off') in ['view', 'edit']
        && t.get('linkKey', '') == d.key;
    }

    // ---------------------------------------------------------------- apGrants
    match /apGrants/{gid} {
      allow get, list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && isActiveUser() && gVerified() && apValidGrant(gid);
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------------- apLibrary
    match /apLibrary/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isActiveUser()
                            && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
                            && request.resource.data.data is string
                            && request.resource.data.data.size() <= 900000
                            && request.resource.data.updatedAt == request.time;
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

