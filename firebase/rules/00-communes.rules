// ============================================================================================================
// Studio Prism - Firestore security rules (website, ARCHIPLAN, ARCHITRAFIC, ARCHIINDUS, SPECTRA Writer, SPECTRA Calc, SPECTRA Slide, NEXUS)
// Everything is denied by default (last rule). Admin = users/{uid}.role == 'admin' AND status == 'active'.
// Paste the WHOLE file in Firebase Console > Firestore Database > Rules, then click Publish.
// ============================================================================================================
rules_version = '2';

// ============================================================================================================
// ============================================================================================================
//
//   products       catalogue central : produits Prism App / Prism Game / Prism 3D (data.js, catalog.js, platform.js)
//
// PRINCIPES
//
// LIMITES DE FIRESTORE PRISES EN COMPTE
//
// ============================================================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ utilitaires

    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveAdminProfile(profile) {
      return profile.get('role', '') == 'admin' && profile.get('status', '') == 'active';
    }

    function isAdmin() {
      return isSignedIn()
        && isActiveAdminProfile(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    function isActiveUser() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'active';
    }

    function isResponsableOf(oid) {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return oid is string && oid != '' && me.get('status', '') == 'active' && me.get('orgRole', '') == 'responsable' && me.get('orgId', '') == oid;
    }

    function isString(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isEmail(v) {
      return isString(v, 3, 160) && v.matches('.+@.+[.].+');
    }

    function isId(v) {
      return v is string && v.matches('[a-z0-9][a-z0-9_-]{1,59}');
    }

    function isSafeUrl(v) {
      return v is string && v.size() <= 300
        && (v == '' || v.matches('https://[!#-:=?-~]+') || v.matches('#/[!#-:=?-~]*') || v.matches('assets/[!#-:=?-~]+'));
    }

    function isMediaRef(v) {
      return v is string && v.matches('media:[A-Za-z0-9]{10,40}');
    }

    function tierOk(range, lim) {
      return (range == '1'      && lim == 1)
          || (range == '2-10'   && lim == 10)
          || (range == '11-25'  && lim == 25)
          || (range == '26-50'  && lim == 50)
          || (range == '51-100' && lim == 100)
          || (range == '100+'   && lim == null);
    }

    // ------------------------------------------------------------ users/{uid}

    function validIndividualProfile(d) {
      return d.accountKind == 'individual'
        && d.keys().hasOnly(['firstName', 'lastName', 'email', 'accountKind', 'subscription', 'role', 'status',
                             'createdAt', 'updatedAt', 'lastLogin', 'termsAcceptedAt']);
    }

    function validCompanyProfile(d) {
      return d.accountKind == 'company'
        && d.keys().hasAll(['companyId', 'companyName', 'companyEmail', 'companyUserRange', 'companyUserLimit'])
        && d.keys().hasOnly(['firstName', 'lastName', 'email', 'accountKind', 'subscription', 'role', 'status',
                             'createdAt', 'updatedAt', 'lastLogin', 'termsAcceptedAt',
                             'companyId', 'companyName', 'companyEmail', 'companyUserRange', 'companyUserLimit', 'jobTitle'])
        && isString(d.companyId, 1, 40)
        && isString(d.companyName, 1, 120)
        && isEmail(d.companyEmail)
        && tierOk(d.companyUserRange, d.companyUserLimit)
        && isString(d.get('jobTitle', ''), 0, 80);
    }

    function validNewUser() {
      let d = request.resource.data;
      return d.keys().hasAll(['firstName', 'lastName', 'email', 'accountKind', 'subscription', 'role', 'status',
                              'createdAt', 'updatedAt', 'lastLogin'])
        && isString(d.firstName, 1, 80)
        && isString(d.lastName, 0, 80)
        && isEmail(d.email)
        && d.email.lower() == request.auth.token.email.lower()
        && d.subscription == 'free'
        && d.role == 'user'
        && ((d.accountKind == 'individual' && d.status == 'active') || (d.accountKind == 'company' && d.status == 'pending'))
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.lastLogin == request.time
        && d.get('termsAcceptedAt', request.time) == request.time
        && (validIndividualProfile(d) || validCompanyProfile(d));
    }

    function ownerUpdateOk() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return resource.data.status == 'active'
        && changed.hasOnly(['firstName', 'lastName', 'jobTitle', 'lastLogin', 'updatedAt'])
        && (!changed.hasAny(['lastLogin']) || d.lastLogin == request.time)
        && (!changed.hasAny(['updatedAt']) || d.updatedAt == request.time)
        && (!changed.hasAny(['firstName', 'lastName', 'jobTitle']) || changed.hasAny(['updatedAt']))
        && (!changed.hasAny(['firstName']) || isString(d.firstName, 1, 80))
        && (!changed.hasAny(['lastName']) || isString(d.lastName, 0, 80))
        && (!changed.hasAny(['jobTitle']) || (resource.data.accountKind == 'company' && isString(d.jobTitle, 0, 80)));
    }

    // Sur SON propre compte : seul l'abonnement peut changer (pas d'auto-promotion, pas d'auto-verrouillage).
    function adminUpdateOk(uid) {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['subscription', 'role', 'status', 'updatedAt', 'orgId', 'orgName', 'orgRole', 'orgClass'])
        && d.updatedAt == request.time
        && isString(d.get('orgId', ''), 0, 40) && isString(d.get('orgName', ''), 0, 120)
        && d.get('orgRole', '') in ['', 'eleve', 'enseignant', 'responsable'] && isString(d.get('orgClass', ''), 0, 60)
        && (d.get('orgId', '') == '' || exists(/databases/$(database)/documents/organizations/$(d.orgId)))
        && d.subscription in ['free', 'pro', 'pro_entreprise']
        && d.role in ['user', 'admin']
        && d.status in ['active', 'suspended']
        && (request.auth.uid != uid || changed.hasOnly(['subscription', 'updatedAt']));
    }

    function ownerToCompanyOk(uid) {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return resource.data.status == 'active' && resource.data.get('accountKind', 'individual') == 'individual'
        && resource.data.get('role', 'user') == 'user'
        && changed.hasOnly(['accountKind', 'status', 'companyId', 'companyName', 'companyEmail', 'companyUserRange', 'companyUserLimit', 'jobTitle', 'updatedAt'])
        && d.accountKind == 'company' && d.status == 'pending' && d.updatedAt == request.time
        && isString(d.companyId, 1, 40) && isString(d.companyName, 1, 120) && isEmail(d.companyEmail)
        && tierOk(d.companyUserRange, d.get('companyUserLimit', null)) && isString(d.get('jobTitle', ''), 0, 80)
        && getAfter(/databases/$(database)/documents/companies/$(d.companyId)).data.ownerUid == uid;
    }

    function ownerOrgJoinOk(uid) {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      let k = getAfter(/databases/$(database)/documents/licenseKeys/$(d.orgKeyId)).data;
      return resource.data.status == 'active'
        && changed.hasOnly(['orgId', 'orgName', 'orgKeyId', 'orgRole', 'orgClass', 'updatedAt'])
        && d.get('orgRole', '') == k.get('role', '') && d.get('orgClass', '') == k.get('classe', '')
        && d.updatedAt == request.time
        && k.redeemedBy == uid && k.status == 'redeemed' && k.redeemedAt == request.time
        && k.orgId == d.orgId && k.orgName == d.orgName && d.orgId != '';
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin()
                  || (isSignedIn() && isResponsableOf(resource.data.get('orgId', '')));   // responsable : comptes de son entreprise
      allow create: if isSignedIn() && request.auth.uid == uid && validNewUser()
                    && (!exists(/databases/$(database)/documents/deletedAccounts/$(uid))
                        || request.resource.data.get('termsAcceptedAt', null) == request.time);
      allow update: if isSignedIn() && (
                         (request.auth.uid == uid && (ownerUpdateOk() || ownerOrgJoinOk(uid) || ownerToCompanyOk(uid)))
                         || (isAdmin() && adminUpdateOk(uid))
                       );
      allow delete: if (isSignedIn() && request.auth.uid == uid
                    && resource.data.get('role', '') == 'user'
                    && resource.data.get('status', '') == 'active'
                    && resource.data.get('accountKind', 'individual') == 'individual')
                    || (isAdmin() && request.auth.uid != uid && resource.data.get('role', 'user') != 'admin'
                        && existsAfter(/databases/$(database)/documents/deletedAccounts/$(uid)));
    }

    // ---------------------------------------------------------------- deletedAccounts
    match /deletedAccounts/{uid} {
      allow read, delete: if isAdmin();
      allow delete: if isSignedIn() && request.auth.uid == uid && existsAfter(/databases/$(database)/documents/users/$(uid));
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isAdmin() && request.auth.uid != uid
                            && request.resource.data.keys().hasOnly(['email', 'name', 'deletedAt', 'by'])
                            && isString(request.resource.data.get('email', ''), 0, 160)
                            && isString(request.resource.data.get('name', ''), 0, 200)
                            && request.resource.data.deletedAt == request.time
                            && request.resource.data.by == request.auth.uid;
    }

    // ------------------------------------------------------------ companies/{companyId}

    function validNewCompany(companyId) {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'email', 'ownerUid', 'userRange', 'userLimit', 'subscription', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'email', 'ownerUid', 'userRange', 'userLimit', 'subscription', 'createdAt', 'updatedAt',
                             'phone', 'website', 'siret', 'repRole'])
        && isString(d.name, 1, 120)
        && isEmail(d.email)
        && (d.get('siret', '') == '' || (d.siret is string && d.siret.matches('[0-9]{14}')))
        && d.get('repRole', '') in ['', 'representant', 'responsable']
        && d.ownerUid == request.auth.uid
        && tierOk(d.userRange, d.userLimit)
        && d.subscription == 'free'
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && isString(d.get('phone', ''), 0, 40)
        && isString(d.get('website', ''), 0, 200)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId;
    }

    function adminCompanyUpdateOk() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['name', 'email', 'userRange', 'userLimit', 'subscription', 'phone', 'website', 'siret', 'repRole', 'updatedAt'])
        && d.updatedAt == request.time
        && d.subscription in ['free', 'pro', 'pro_entreprise']
        && isString(d.name, 1, 120)
        && isEmail(d.email)
        && tierOk(d.userRange, d.userLimit)
        && isString(d.get('phone', ''), 0, 40)
        && isString(d.get('website', ''), 0, 200);
    }

    // ---------------------------------------------------------------- companies
    match /companies/{companyId} {
      allow get: if isSignedIn() && (
                      isAdmin()
                      || (isActiveUser() && (
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId
                            || resource.data.ownerUid == request.auth.uid))
                    );
      allow list: if isAdmin();
      allow create: if isSignedIn() && validNewCompany(companyId);
      allow update: if isAdmin() && adminCompanyUpdateOk();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------ catalogue : products/{productId}

    function validProduct(pid) {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'slug', 'category', 'description', 'logo', 'image', 'url', 'status', 'featured',
                              'displayOrder', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'slug', 'category', 'tagline', 'description', 'logo', 'image', 'url', 'status', 'featured',
                             'displayOrder', 'createdAt', 'updatedAt', 'pole', 'stage', 'availability', 'info', 'platforms', 'website',
                             'details', 'highlights'])
        && isId(pid)
        && d.slug == pid
        && isString(d.name, 1, 80)
        && isString(d.get('tagline', ''), 0, 80)
        && d.category in ['application', 'game', '3d', 'service', 'other']
        && d.get('pole', 'app') in ['app', 'game', 'p3d']
        && d.get('stage', 'concept') in ['concept', 'conception', 'prototype', 'beta', 'released']
        && isString(d.get('availability', ''), 0, 120)
        && isString(d.get('info', ''), 0, 1000)
        && d.get('platforms', []) is list && d.get('platforms', []).size() <= 8
        && isString(d.description, 0, 1000)
        && (isSafeUrl(d.logo) || isMediaRef(d.logo)) && (isSafeUrl(d.image) || isMediaRef(d.image)) && isSafeUrl(d.url)
        && (d.get('website', '') == '' || (d.website is string && d.website.size() <= 300 && d.website.matches('https://[!#-:=?-~]+')))
        && isString(d.get('details', ''), 0, 5000)
        && d.get('highlights', []) is list && d.get('highlights', []).size() <= 12
        && d.status in ['published', 'draft', 'unavailable', 'archived', 'active', 'hidden']
        && d.featured is bool
        && d.displayOrder is int && d.displayOrder >= 0 && d.displayOrder <= 9999
        && d.updatedAt == request.time;
    }

    // ---------------------------------------------------------------- products
    match /products/{pid} {
      allow get, list: if isAdmin()
                       || resource.data.status == 'published'
                       || resource.data.status == 'unavailable'
                       || resource.data.status == 'active';
      allow create: if isAdmin() && validProduct(pid) && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validProduct(pid) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------ formules : subscriptions/{planId}

    function validPlan(sid) {
      let d = request.resource.data;
      return d.keys().hasAll(['productId', 'productName', 'name', 'slug', 'description', 'mode', 'features', 'licenseType',
                              'status', 'featured', 'displayOrder', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['productId', 'productName', 'name', 'slug', 'description', 'mode', 'features', 'licenseType',
                             'status', 'featured', 'displayOrder', 'createdAt', 'updatedAt'])
        && isId(sid)
        && d.slug == sid
        && isId(d.productId)
        && isString(d.productName, 1, 80)
        && isString(d.name, 1, 80)
        && isString(d.description, 0, 500)
        && d.mode in ['free', 'one_time', 'subscription', 'quote']
        && d.features is list && d.features.size() <= 40
        && d.licenseType.matches('[a-z][a-z0-9_]{1,39}')
        && d.status in ['active', 'inactive']
        && d.featured is bool
        && d.displayOrder is int && d.displayOrder >= 0 && d.displayOrder <= 9999
        && d.updatedAt == request.time;
    }

    function validLegacyOffer(sid) {
      let d = request.resource.data;
      return d.keys().hasAll(['productId', 'productName', 'name', 'slug', 'description', 'price', 'currency', 'billingPeriod',
                              'features', 'licenseType', 'status', 'featured', 'displayOrder', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['productId', 'productName', 'name', 'slug', 'description', 'price', 'currency', 'billingPeriod',
                             'features', 'licenseType', 'status', 'featured', 'displayOrder', 'createdAt', 'updatedAt'])
        && isId(sid)
        && d.slug == sid
        && isId(d.productId)
        && isString(d.productName, 1, 80)
        && isString(d.name, 1, 80)
        && isString(d.description, 0, 500)
        && d.currency.matches('[A-Z]{3}')
        && ((d.billingPeriod == 'free' && d.price == 0)
            || (d.billingPeriod == 'quote' && d.price == null)
            || (d.billingPeriod in ['monthly', 'yearly'] && d.price is number && d.price > 0 && d.price < 1000000))
        && d.features is list && d.features.size() <= 40
        && d.licenseType.matches('[a-z][a-z0-9_]{1,39}')
        && d.status in ['active', 'inactive']
        && d.featured is bool
        && d.displayOrder is int && d.displayOrder >= 0 && d.displayOrder <= 9999
        && d.updatedAt == request.time;
    }

    // ---------------------------------------------------------------- subscriptions
    match /subscriptions/{sid} {
      allow get, list: if isAdmin() || resource.data.status == 'active';
      allow create: if isAdmin() && validPlan(sid) && request.resource.data.createdAt == request.time
                    && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.name
                       == request.resource.data.productName;
      allow update: if isAdmin() && (validPlan(sid) || validLegacyOffer(sid))
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.productId == resource.data.productId;
      allow delete: if isAdmin();
    }

    //   period : once (achat unique) / monthly / quarterly / yearly ; legacyId = identifiant de l'ancienne offre reprise.
    function validPrice(prid) {
      let d = request.resource.data;
      return d.keys().hasAll(['planId', 'productId', 'period', 'amount', 'currency', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['planId', 'productId', 'period', 'amount', 'currency', 'status', 'legacyId', 'createdAt', 'updatedAt'])
        && isId(d.planId)
        && isId(d.productId)
        && d.period in ['once', 'monthly', 'quarterly', 'yearly']
        && prid == d.planId + '_' + d.period
        && d.amount is number && d.amount > 0 && d.amount < 1000000
        && d.currency.matches('[A-Z]{3}')
        && d.status in ['active', 'inactive']
        && isString(d.get('legacyId', ''), 0, 60)
        && d.updatedAt == request.time;
    }

    function priceFitsPlan() {
      let d = request.resource.data;
      let plan = getAfter(/databases/$(database)/documents/subscriptions/$(d.planId)).data;
      return plan.get('productId', '') == d.productId
        && ((plan.get('mode', '') == 'one_time' && d.period == 'once')
            || (plan.get('mode', '') == 'subscription' && d.period in ['monthly', 'quarterly', 'yearly']));
    }

    // ---------------------------------------------------------------- prices
    match /prices/{prid} {
      allow get, list: if isAdmin() || resource.data.status == 'active';
      allow create: if isAdmin() && validPrice(prid) && request.resource.data.createdAt == request.time && priceFitsPlan();
      allow update: if isAdmin() && validPrice(prid) && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.planId == resource.data.planId
                    && request.resource.data.productId == resource.data.productId
                    && request.resource.data.period == resource.data.period;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- settings
    match /settings/{sid} {
      allow get: if sid == 'catalogue';
      allow create, update: if isAdmin() && sid == 'catalogue'
                            && request.resource.data.keys().hasAll(['builtinImported', 'updatedAt'])
                            && request.resource.data.keys().hasOnly(['builtinImported', 'updatedAt'])
                            && request.resource.data.builtinImported is bool
                            && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ------------------------------------------------------------ licences : licenses/{userId_productId}

    function validLicenseFields() {
      let d = request.resource.data;
      return d.keys().hasAll(['userId', 'productId', 'productName', 'licenseType', 'status', 'activatedAt', 'expiresAt',
                              'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['userId', 'productId', 'productName', 'licenseType', 'status', 'activatedAt', 'expiresAt',
                             'createdAt', 'updatedAt', 'keyId', 'orgId'])
        && isString(d.get('keyId', ''), 0, 64) && isString(d.get('orgId', ''), 0, 40)
        && d.userId is string && d.userId.matches('[A-Za-z0-9_-]{1,128}')
        && isId(d.productId)
        && isString(d.productName, 1, 80)
        && d.licenseType.matches('[a-z][a-z0-9_]{1,39}')
        && d.status in ['active', 'suspended', 'expired']
        && d.activatedAt is timestamp
        && (d.expiresAt == null || (d.expiresAt is timestamp && d.expiresAt > d.activatedAt))
        && d.updatedAt == request.time;
    }

    function keyLicenseOk(lid) {
      let d = request.resource.data;
      let k = getAfter(/databases/$(database)/documents/licenseKeys/$(d.keyId)).data;
      let end = k.get('durationDays', null) == null ? null : request.time + duration.value(k.durationDays, 'd');
      return validLicenseFields()
        && d.userId == request.auth.uid && lid == d.userId + '_' + d.productId
        && k.redeemedBy == request.auth.uid && k.status == 'redeemed' && k.redeemedAt == request.time
        && d.productId == k.productId && d.productName == k.productName && d.licenseType == k.licenseType
        && d.status == 'active' && d.activatedAt == request.time && d.get('orgId', '') == k.get('orgId', '')
        && (k.licenseType != 'pro_entreprise' || k.get('orgId', '') != '')
        && (k.get('expiresAt', null) != null ? d.expiresAt == k.expiresAt
            : end == null ? d.expiresAt == null
            : (d.expiresAt is timestamp && d.expiresAt > end - duration.value(10, 'm') && d.expiresAt < end + duration.value(10, 'm')));
    }

    // ---------------------------------------------------------------- licenses
    match /licenses/{lid} {
      allow get, list: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid && isActiveUser()));
      allow create: if (isSignedIn() && isActiveUser() && keyLicenseOk(lid) && request.resource.data.createdAt == request.time)
                    || isAdmin() && validLicenseFields() && request.resource.data.createdAt == request.time
                    && lid == request.resource.data.userId + '_' + request.resource.data.productId
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.userId))
                    && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.name
                       == request.resource.data.productName;
      allow update: if (isSignedIn() && isActiveUser() && resource.data.userId == request.auth.uid && keyLicenseOk(lid)
                        && request.resource.data.createdAt == resource.data.createdAt)
                    || isAdmin() && validLicenseFields() && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.productId == resource.data.productId;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid
                        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)))
                    || isAdmin();
    }

    function validOrg() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'kind', 'seats', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'kind', 'siret', 'email', 'phone', 'address', 'contactName', 'seats', 'notes', 'status', 'createdAt', 'updatedAt'])
        && isString(d.name, 1, 120)
        && d.kind in ['entreprise', 'etablissement', 'ecole', 'collectivite', 'association', 'autre']
        && isString(d.get('siret', ''), 0, 20) && isString(d.get('email', ''), 0, 160) && isString(d.get('phone', ''), 0, 40)
        && isString(d.get('address', ''), 0, 300) && isString(d.get('contactName', ''), 0, 120) && isString(d.get('notes', ''), 0, 1000)
        && d.seats is int && d.seats >= 1 && d.seats <= 10000
        && d.status in ['active', 'suspended']
        && d.updatedAt == request.time;
    }

    // ---------------------------------------------------------------- organizations
    match /organizations/{oid} {
      allow get: if isSignedIn() && (isAdmin()
                    || (isActiveUser() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', '') == oid));
      allow list: if isAdmin();
      allow create: if isAdmin() && validOrg() && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validOrg() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    function validKey(kid) {
      let d = request.resource.data;
      return d.keys().hasAll(['key', 'productId', 'productName', 'licenseType', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['key', 'productId', 'productName', 'licenseType', 'durationDays', 'expiresAt', 'orgId', 'orgName', 'label',
                             'role', 'classe', 'status', 'redeemedBy', 'redeemedEmail', 'redeemedAt', 'createdAt', 'updatedAt'])
        && d.get('role', '') in ['', 'eleve', 'enseignant'] && isString(d.get('classe', ''), 0, 60)
        && kid.matches('[0-9a-f]{64}')
        && isString(d.key, 12, 60) && isId(d.productId) && isString(d.productName, 1, 80)
        && d.licenseType.matches('[a-z][a-z0-9_]{1,39}')
        && (d.get('durationDays', null) == null || (d.durationDays is int && d.durationDays >= 1 && d.durationDays <= 3650))
        && (d.get('expiresAt', null) == null || d.expiresAt is timestamp)
        && isString(d.get('orgId', ''), 0, 40) && isString(d.get('orgName', ''), 0, 120) && isString(d.get('label', ''), 0, 120)
        && (d.get('orgId', '') == '' || exists(/databases/$(database)/documents/organizations/$(d.orgId)))
        && d.status in ['available', 'redeemed', 'revoked']
        && d.updatedAt == request.time;
    }

    // ---------------------------------------------------------------- licenseKeys
    match /licenseKeys/{kid} {
      allow get: if isSignedIn() && (isAdmin() || isActiveUser());
      allow list: if isAdmin() || (isSignedIn() && isResponsableOf(resource.data.get('orgId', '')));
      allow create: if isAdmin() && validKey(kid) && request.resource.data.status == 'available' && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() && validKey(kid) && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'role', 'classe', 'status', 'updatedAt'])
                        && (resource.data.status != 'redeemed' || request.resource.data.status == 'redeemed'))
                    || (isSignedIn() && isActiveUser() && resource.data.status == 'available'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'redeemedBy', 'redeemedEmail', 'redeemedAt', 'updatedAt'])
                        && request.resource.data.status == 'redeemed'
                        && request.resource.data.redeemedBy == request.auth.uid
                        && request.resource.data.redeemedEmail == request.auth.token.email.lower()
                        && request.resource.data.redeemedAt == request.time && request.resource.data.updatedAt == request.time
                        && (resource.data.get('expiresAt', null) == null || resource.data.expiresAt > request.time)
                        && getAfter(/databases/$(database)/documents/licenses/$(request.auth.uid + '_' + resource.data.productId)).data.get('keyId', '') == kid);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------ demandes de licences d'entreprise : licenseRequests/{id}
    function validRequestItems(items) {
      return items is list && items.size() >= 1 && items.size() <= 6;
    }
    function validLicenseRequest() {
      let d = request.resource.data;
      return d.keys().hasAll(['kind', 'requesterUid', 'requesterEmail', 'items', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['kind', 'requesterUid', 'requesterEmail', 'requesterName', 'companyId', 'companyName', 'orgId', 'items',
                             'emails', 'repRole', 'siret', 'status', 'createdAt', 'updatedAt'])
        && d.requesterUid == request.auth.uid && d.status == 'pending'
        && d.createdAt == request.time && d.updatedAt == request.time
        && isEmail(d.requesterEmail) && isString(d.get('requesterName', ''), 0, 160)
        && isString(d.get('companyId', ''), 0, 40) && isString(d.get('companyName', ''), 0, 120) && isString(d.get('orgId', ''), 0, 40)
        && d.get('repRole', '') in ['', 'representant', 'responsable']
        && (d.get('siret', '') == '' || (d.siret is string && d.siret.matches('[0-9]{14}')))
        && validRequestItems(d.items)
        && ((d.kind == 'signup'
             && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'pending'
             && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountKind', '') == 'company')
            || (d.kind == 'member' && isResponsableOf(d.get('orgId', ''))
                && d.get('emails', []) is list && d.emails.size() >= 1 && d.emails.size() <= 50));
    }

    // ---------------------------------------------------------------- licenseRequests
    match /licenseRequests/{rid} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.requesterUid == request.auth.uid);
      allow create: if isSignedIn() && validLicenseRequest();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.requesterUid == request.auth.uid && resource.data.status == 'pending');
    }

    function validContent(c) {
      return c is map
        && c.keys().hasOnly(['v', 'seo', 'texts', 'attrs', 'layout', 'hidden', 'extra'])
        && c.keys().hasAll(['v'])
        && c.v == 1
        && (!('seo' in c) || c.seo is map)
        && (!('texts' in c) || (c.texts is map && c.texts.size() <= 800))
        && (!('attrs' in c) || (c.attrs is map && c.attrs.size() <= 400))
        && (!('layout' in c) || (c.layout is list && c.layout.size() <= 120))
        && (!('hidden' in c) || (c.hidden is list && c.hidden.size() <= 120))
        && (!('extra' in c) || (c.extra is list && c.extra.size() <= 40));
    }

    function isPageId(v) {
      return v is string && v.matches('[a-z0-9][a-z0-9-]{0,58}');
    }

    function pageFieldsOk(pid) {
      let d = request.resource.data;
      return isPageId(pid)
        && d.kind in ['builtin', 'custom']
        && (d.kind == 'custom') == pid.matches('c-[a-z0-9-]{1,56}')
        && isString(d.title, 0, 120)
        && d.slug is string && (d.kind == 'custom' ? pid == 'c-' + d.slug : pid == d.slug)
        && d.footer is bool
        && validContent(d.content)
        && d.mediaIds is list && d.mediaIds.size() <= 80
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    function validPage(pid) {
      let d = request.resource.data;
      return d.keys().hasAll(['kind', 'title', 'slug', 'status', 'footer', 'content', 'mediaIds', 'revision', 'publishedAt', 'updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['kind', 'title', 'slug', 'status', 'footer', 'content', 'mediaIds', 'revision', 'publishedAt', 'updatedAt', 'updatedBy'])
        && pageFieldsOk(pid)
        && d.status in ['published', 'archived']
        && d.revision is int && d.revision >= 1 && d.revision <= 100000;
    }

    // ---------------------------------------------------------------- pages
    match /pages/{pid} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create: if isAdmin() && validPage(pid) && request.resource.data.status == 'published'
                    && request.resource.data.revision == 1 && request.resource.data.publishedAt == request.time;
      allow update: if isAdmin() && validPage(pid)
                    && request.resource.data.kind == resource.data.kind
                    && request.resource.data.revision >= resource.data.revision
                    && (request.resource.data.publishedAt == request.time || request.resource.data.publishedAt == resource.data.publishedAt);
      allow delete: if isAdmin();
    }

    function validPageDraft(pid) {
      let d = request.resource.data;
      return d.keys().hasAll(['kind', 'title', 'slug', 'footer', 'content', 'mediaIds', 'baseRevision', 'updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['kind', 'title', 'slug', 'footer', 'content', 'mediaIds', 'baseRevision', 'updatedAt', 'updatedBy'])
        && pageFieldsOk(pid)
        && d.baseRevision is int && d.baseRevision >= 0 && d.baseRevision <= 100000;
    }

    // ---------------------------------------------------------------- pageDrafts
    match /pageDrafts/{pid} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validPageDraft(pid);
      allow delete: if isAdmin();
    }

    function validProject(pid) {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'slug', 'summary', 'description', 'image', 'link', 'productId', 'tags', 'year', 'status',
                              'featured', 'displayOrder', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['title', 'slug', 'summary', 'description', 'image', 'link', 'productId', 'tags', 'year', 'status',
                             'featured', 'displayOrder', 'createdAt', 'updatedAt'])
        && isId(pid)
        && d.slug == pid
        && isString(d.title, 1, 120)
        && isString(d.summary, 0, 300)
        && isString(d.description, 0, 3000)
        && (isSafeUrl(d.image) || isMediaRef(d.image))
        && isSafeUrl(d.link)
        && (d.productId == '' || isId(d.productId))
        && d.tags is list && d.tags.size() <= 8
        && isString(d.year, 0, 10)
        && d.status in ['published', 'draft', 'archived']
        && d.featured is bool
        && d.displayOrder is int && d.displayOrder >= 0 && d.displayOrder <= 9999
        && d.updatedAt == request.time;
    }

    // ---------------------------------------------------------------- projects
    match /projects/{pid} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create: if isAdmin() && validProject(pid) && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validProject(pid) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    function validMedia(mid) {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'folder', 'alt', 'title', 'kind', 'mime', 'size', 'source', 'url', 'path', 'public',
                              'createdAt', 'updatedAt', 'createdBy'])
        && d.keys().hasOnly(['name', 'folder', 'alt', 'title', 'kind', 'mime', 'size', 'source', 'url', 'path', 'public', 'width',
                             'height', 'createdAt', 'updatedAt', 'createdBy', 'replacedAt'])
        && mid.matches('[A-Za-z0-9]{10,40}')
        && isString(d.name, 1, 120)
        && isString(d.folder, 0, 60)
        && isString(d.alt, 0, 250)
        && isString(d.title, 0, 120)
        && d.kind in ['image', 'video']
        && d.mime in ['image/jpeg', 'image/png', 'image/webp', 'image/gif', 'video/mp4', 'video/webm']
        && (d.kind == 'image') == d.mime.matches('image/.*')
        && d.size is int && d.size >= 0 && d.size <= 52428800
        && d.source in ['upload', 'link']
        && d.url is string && d.url.size() <= 1500 && d.url.matches('https://[!#-:=?-~]+')
        && d.path is string && d.path.size() <= 300
        && (d.source == 'upload' ? d.path.matches('media/' + mid + '/[A-Za-z0-9._-]{1,120}') : d.path == '')
        && d.public is bool
        && (!('width' in d) || (d.width is int && d.width >= 0 && d.width <= 20000))
        && (!('height' in d) || (d.height is int && d.height >= 0 && d.height <= 20000))
        && d.updatedAt == request.time
        && d.createdBy is string && d.createdBy.size() <= 128;
    }

    // ---------------------------------------------------------------- media
    match /media/{mid} {
      allow get: if isAdmin() || resource.data.public == true;
      allow list: if isAdmin();
      allow create: if isAdmin() && validMedia(mid) && request.resource.data.createdAt == request.time
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() && validMedia(mid) && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.source == resource.data.source;
      allow delete: if isAdmin();
    }

