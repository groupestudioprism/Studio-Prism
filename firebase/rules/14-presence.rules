
    // ---------------------------------------------------------------- presence/{uid}_{app}
    // Qui est connecté maintenant, et dans quel logiciel (shared/prism-status.js) : un document par compte ET par logiciel,
    // rafraîchi toutes les ~60 s tant que l'onglet est visible, supprimé à la fermeture. Lu par l'administration (tableau de bord).
    match /presence/{pid} {
      allow get: if isSignedIn() && (isAdmin() || pid.matches(request.auth.uid + '_[a-z0-9-]{2,30}'));
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && isActiveUser()
                            && request.resource.data.keys().hasOnly(['uid', 'app', 'lastSeen'])
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.app is string && request.resource.data.app.matches('[a-z0-9-]{2,30}')
                            && pid == request.auth.uid + '_' + request.resource.data.app
                            && request.resource.data.lastSeen == request.time;
      allow delete: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }
